@model Pta_lession06.Models.Ptamember

@{
    ViewData["Title"] = "Thêm mới thành viên";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 col-md-8 mx-auto">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Thêm mới thành viên (Model Binding Form)</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="PtamemberId" class="form-label fw-bold">Mã thành viên</label>
                    <input asp-for="PtamemberId" class="form-control" placeholder="Để trống để tự sinh mã (VD: PTA004)" />
                </div>

                <div class="mb-3">
                    <label asp-for="PtamemberUserName" class="form-label fw-bold">Tên đăng nhập (*)</label>
                    <input asp-for="PtamemberUserName" class="form-control" required placeholder="Nhập tên đăng nhập" />
                </div>

                <div class="mb-3">
                    <label asp-for="PtamemberFullName" class="form-label fw-bold">Họ và tên (*)</label>
                    <input asp-for="PtamemberFullName" class="form-control" required placeholder="Nhập họ và tên đầy đủ" />
                </div>

                <div class="mb-3">
                    <label asp-for="PtamemberPassword" class="form-label fw-bold">Mật khẩu (*)</label>
                    <input asp-for="PtamemberPassword" type="password" class="form-control" required placeholder="Nhập mật khẩu" />
                </div>

                <div class="mb-3">
                    <label asp-for="PtamemberEmail" class="form-label fw-bold">Email (*)</label>
                    <input asp-for="PtamemberEmail" type="email" class="form-control" required placeholder="Nhập địa chỉ email" />
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">&larr; Quay lại danh sách</a>
                    <button type="submit" class="btn btn-success px-4">Lưu thành viên</button>
                </div>
            </form>
        </div>
    </div>
</div>
