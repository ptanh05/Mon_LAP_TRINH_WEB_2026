@model IEnumerable<Pta_lession06.Models.Ptamember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary"><i class="bi bi-people-fill"></i> Danh sách thành viên (Ptamember - Scaffolding List)</h2>
        <a asp-action="Create" class="btn btn-success">
            + Thêm mới thành viên
        </a>
    </div>

    <table class="table table-bordered table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Mã thành viên</th>
                <th>Tên đăng nhập</th>
                <th>Họ và tên</th>
                <th>Email</th>
                <th class="text-center" style="width: 250px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.PtamemberId</td>
                    <td>@item.PtamemberUserName</td>
                    <td>@item.PtamemberFullName</td>
                    <td>@item.PtamemberEmail</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.PtamemberId" class="btn btn-sm btn-warning me-1">Sửa</a>
                        <a asp-action="PtaGetDetails" asp-route-id="@item.PtamemberId" class="btn btn-sm btn-info me-1 text-white">Chi tiết</a>
                        <a asp-action="Delete" asp-route-id="@item.PtamemberId" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên này?');">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">Chưa có thành viên nào trong danh sách.</td>
            </tr>
        }
        </tbody>
    </table>
</div>
