@model IEnumerable<PtaLession07Annotation.Models.PtaMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PtaUsername)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PtaPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PtaEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PtaPhone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.PtaUsername)
            </td>
            <td>
                @Html.DisplayFor(model => item.PtaPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.PtaEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.PtaPhone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
