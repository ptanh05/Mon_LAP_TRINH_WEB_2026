@model IEnumerable<Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<!-- Mục 8: So sánh 2 cách viết link Create Student -->
<!-- Cách 1 (Tag Helper): <a asp-controller="Student" asp-action="Create" class="btn btn-primary mb-3">Create Student</a> -->
<!-- Cách 2 (HTML thuần theo Route mới): -->
<a href="/Admin/Student/Add" class="btn btn-primary mb-3">Create Student</a>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Mã</th>
            <th>Ảnh</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>
                    @if (!string.IsNullOrEmpty(s.Avatar))
                    {
                        <img src="@s.Avatar" alt="Avatar" width="45" height="45" class="rounded-circle object-fit-cover" />
                    }
                    else
                    {
                        <span class="badge bg-secondary">No avatar</span>
                    }
                </td>
                <td>@s.Name</td>
                <td>@(s.DateOfBorth == DateTime.MinValue ? "1/1/0001 12:00:00 AM" : s.DateOfBorth.ToString("M/d/yyyy h:mm:ss tt"))</td>
                <td>
                    @{
                        string str = "";
                        switch (s.Branch)
                        {
                            case Branch.IT:
                                str = "CNTT";
                                break;
                            case Branch.BE:
                                str = "Kinh tế";
                                break;
                            case Branch.CE:
                                str = "Công trình";
                                break;
                            case Branch.EE:
                                str = "Điện - Điện tử";
                                break;
                            default:
                                str = s.Branch?.ToString() ?? "";
                                break;
                        }
                    }
                    @str
                </td>
                <td>@(s.Gender == Gender.Male ? "Nam" : "Nữ")</td>
                <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@s.Address</td>
                <td>@s.Email</td>
            </tr>
        }
    </tbody>
</table>
