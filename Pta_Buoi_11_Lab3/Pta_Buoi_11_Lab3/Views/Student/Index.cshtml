@model IEnumerable<Pta_Buoi_11_Lab3.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h2>Danh sách sinh viên</h2>
    <a asp-action="Create" class="btn btn-primary">Thêm mới sinh viên</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white">
        <i class="fas fa-table me-1"></i>
        Student List
    </div>
    <div class="card-body">
        <table class="table table-striped table-bordered table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã</th>
                    <th>Họ tên</th>
                    <th>Ngày sinh</th>
                    <th>Ngành</th>
                    <th>Giới tính</th>
                    <th>Hệ ĐT</th>
                    <th>Địa chỉ</th>
                    <th>Email</th>
                    <th>Điểm</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.Id</td>
                            <td>@s.Name</td>
                            <td>@(s.DateOfBorth?.ToString("dd/MM/yyyy") ?? "")</td>
                            <td>
                                @switch (s.Branch)
                                {
                                    case Branch.IT: <span>CNTT</span>; break;
                                    case Branch.BE: <span>Kinh tế</span>; break;
                                    case Branch.CE: <span>Công trình</span>; break;
                                    case Branch.EE: <span>Điện - Điện tử</span>; break;
                                    default: <span>@s.Branch</span>; break;
                                }
                            </td>
                            <td>@(s.Gender == Gender.Male ? "Nam" : (s.Gender == Gender.Female ? "Nữ" : ""))</td>
                            <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                            <td>@s.Address</td>
                            <td>@s.Email</td>
                            <td><strong>@(s.Score.HasValue ? s.Score.Value.ToString("0.0") : "")</strong></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted">Không có sinh viên nào trong danh sách.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
