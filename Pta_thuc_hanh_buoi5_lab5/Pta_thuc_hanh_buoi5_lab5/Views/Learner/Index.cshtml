@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}
@model IEnumerable<Learner>
<div class="ms-2 mx-2">
    <h1>Learner List</h1>
    @await Component.InvokeAsync("Major")
    <!--Thêm form tìm kiếm-->
    <form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0" onsubmit="return false;">
        <div class="input-group">
            <input id="keyword" class="form-control" name="keyword"
                type="text" placeholder="Search learner" value="@ViewBag.keyword"/>
            <button id="btnSearch" class="btn btn-primary" type="button">
                <i class="fas fa-search"></i></button>
        </div>
    </form>
    <div id="content">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Tên</th>
                    <th>Họ</th>
                    <th>Ngành</th>
                    <th>Ngày Nhập Học</th>
                    <th>Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.LearnerID</td>
                        <td>@s.FirstMidName</td>
                        <td>@s.LastName</td>
                        <td>@s.Major?.MajorName</td>
                        <td>@s.EnrollmentDate</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@s.LearnerID">Edit</a>|
                            <a asp-action="Delete" asp-route-id="@s.LearnerID">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <!--Thêm thanh nav-phân trang-->
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.pageNum; i++)
            {
                <li class="page-item" page="@i"
                    @(ViewBag.mid != null ? "mid=" + ViewBag.mid : "")
                    @(ViewBag.keyword != null ? "keyword=" + ViewBag.keyword : "")>
                    <a class="page-link" style="cursor: pointer;">@i</a>
                </li>
            }
        </ul>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create New Student</a>
</div>
@section Scripts{
<script>
    // Hàm gọi filter dùng chung cho tất cả các thao tác AJAX
    function loadLearners(mid, keyword, page) {
        var data = {};
        if (mid) data.mid = mid;
        if (keyword !== undefined && keyword !== null) data.keyword = keyword;
        if (page) data.pageIndex = page;

        $.ajax({
            url: '@Url.Action("LearnerFilter", "Learner")',
            data: data,
            success: function (response) {
                $("div#content").html(response);
            },
            error: function () {
                // Fallback nếu chạy url relative
                $.ajax({
                    url: "LearnerFilter",
                    data: data,
                    success: function (res) {
                        $("div#content").html(res);
                    }
                });
            }
        });
    }

    // Sự kiện click vào trang phân trang
    $('body').on('click', 'li.page-item', function (e) {
        e.preventDefault();
        var page = $(this).attr("page");
        var mid = $(this).attr("mid");
        var keyword = $(this).attr("keyword");
        loadLearners(mid, keyword, page);
    });

    // Sự kiện click vào chuyên ngành
    $('body').on('click', '.nav li', function (e) {
        e.preventDefault();
        var id = $(this).attr("id");
        var keyword = $("#keyword").val();
        loadLearners(id, keyword, 1);
    });

    // Sự kiện click nút tìm kiếm
    $('body').on('click', '#btnSearch, button#btnSearch', function (e) {
        e.preventDefault();
        var keyword = $("#keyword").val();
        var mid = $("li.page-item").first().attr("mid");
        loadLearners(mid, keyword, 1);
    });

    // Ngăn chặn form submit và hỗ trợ nhấn Enter trong ô tìm kiếm
    $('form').on('submit', function (e) {
        e.preventDefault();
        $('#btnSearch').click();
    });

    $('#keyword').on('keypress', function (e) {
        if (e.which === 13) {
            e.preventDefault();
            $('#btnSearch').click();
        }
    });
</script>
}
