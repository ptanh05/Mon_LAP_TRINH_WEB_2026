@model IEnumerable<TaiSan>

<div class="section-head">
    <h3>@ViewBag.TieuDe</h3>
    <a asp-controller="Home" asp-action="Create">+ Thêm tài sản</a>
</div>
<div class="grid">
    @foreach (var item in Model)
    {
        <div class="asset-card">
            <a href="#"><img src="~/images/@(string.IsNullOrEmpty(item.Anh) ? "Img_1.jpg" : item.Anh)" alt="@item.TenTs" /></a>
            <h2>@item.TenTs</h2>
            <div class="asset-foot">
                <span class="price">@(item.NguyenGia.HasValue ? $"{item.NguyenGia:0} tr" : "Chưa định giá")</span>
                <button type="button" class="btn-buy">Chi tiết</button>
            </div>
        </div>
    }
</div>
