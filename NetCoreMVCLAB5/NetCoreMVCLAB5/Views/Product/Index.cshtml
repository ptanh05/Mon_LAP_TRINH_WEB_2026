@model IEnumerable<NetCoreMVCLAB5.Models.Product>

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">Danh sách Sản phẩm</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Thêm mới Sản phẩm
        </a>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 70px;">Mã</th>
                    <th style="width: 100px;">Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th class="text-end">Giá chuẩn</th>
                    <th class="text-end">Giá KM</th>
                    <th>Mô tả</th>
                    <th class="text-center" style="width: 190px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center fw-bold">@item.Id</td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="@item.Image" alt="@item.Name" class="img-thumbnail" style="width: 70px; height: 70px; object-fit: cover;" onerror="this.src='https://placehold.co/70x70?text=No+Image';" />
                            }
                            else
                            {
                                <span class="badge bg-secondary">Không có ảnh</span>
                            }
                        </td>
                        <td class="fw-semibold">@item.Name</td>
                        <td>
                            <span class="badge bg-info text-dark">@(item.Category?.Name ?? "Chưa phân loại")</span>
                        </td>
                        <td class="text-end text-muted text-decoration-line-through">
                            @item.Price.ToString("N0") đ
                        </td>
                        <td class="text-end text-danger fw-bold">
                            @item.SalePrice.ToString("N0") đ
                        </td>
                        <td class="small text-muted" style="max-width: 250px;">
                            @(item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Xem</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">
                        Chưa có sản phẩm nào. Hãy bấm "+ Thêm mới Sản phẩm" để thêm mới.
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
