@model NetCoreMVCLAB5.Models.Product

@{
    ViewData["Title"] = "Chi tiết Sản phẩm";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white py-3">
                    <h4 class="mb-0 fw-bold">Chi tiết Sản phẩm</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-5 text-center mb-3 mb-md-0">
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <img src="@Model.Image" alt="@Model.Name" class="img-fluid rounded border shadow-sm" style="max-height: 280px; object-fit: cover;" onerror="this.src='https://placehold.co/300x300?text=No+Image';" />
                            }
                            else
                            {
                                <div class="bg-light p-5 rounded border text-muted">Chưa có ảnh</div>
                            }
                        </div>
                        <div class="col-md-7">
                            <h3 class="fw-bold text-primary mb-2">@Model.Name</h3>
                            <p class="mb-2">
                                <span class="badge bg-secondary">Mã SP: #@Model.Id</span>
                                <span class="badge bg-primary">@(Model.Category?.Name ?? "Chưa phân loại")</span>
                            </p>

                            <div class="mb-3 p-3 bg-light rounded">
                                <div class="text-muted small">Giá gốc: <del>@Model.Price.ToString("N0") VNĐ</del></div>
                                <div class="fs-4 fw-bold text-danger">@Model.SalePrice.ToString("N0") VNĐ</div>
                                @if (Model.Price > 0)
                                {
                                    float discountPercent = (1 - (Model.SalePrice / Model.Price)) * 100;
                                    <div class="text-success small fw-semibold">Tiết kiệm: @discountPercent.ToString("0.#")%</div>
                                }
                            </div>

                            <div>
                                <h6 class="fw-bold text-secondary">Mô tả sản phẩm:</h6>
                                <p class="text-muted" style="white-space: pre-line;">@Model.Description</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-top p-3 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        &larr; Quay lại danh sách
                    </a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-3 me-2">Chỉnh sửa</a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger px-3">Xóa</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
