@model NetCoreMVCLAB5.Models.Product

@{
    ViewData["Title"] = "Xóa Sản phẩm";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0 fw-bold">Xác nhận xóa Sản phẩm</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Bạn có chắc chắn muốn xóa sản phẩm này không? Thao tác này không thể hoàn tác.
                    </div>

                    <div class="d-flex align-items-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img src="@Model.Image" alt="@Model.Name" class="img-thumbnail me-3" style="width: 80px; height: 80px; object-fit: cover;" onerror="this.src='https://placehold.co/80x80?text=No+Image';" />
                        }
                        <div>
                            <h5 class="fw-bold mb-1">@Model.Name</h5>
                            <span class="badge bg-secondary">Mã SP: #@Model.Id</span>
                            <span class="badge bg-info text-dark">@(Model.Category?.Name ?? "Chưa phân loại")</span>
                        </div>
                    </div>

                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Giá chuẩn:</span>
                            <span>@Model.Price.ToString("N0") VNĐ</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Giá khuyến mãi:</span>
                            <span class="text-danger fw-bold">@Model.SalePrice.ToString("N0") VNĐ</span>
                        </li>
                    </ul>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-secondary">
                                &larr; Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-danger px-4 fw-semibold">
                                Đồng ý xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
