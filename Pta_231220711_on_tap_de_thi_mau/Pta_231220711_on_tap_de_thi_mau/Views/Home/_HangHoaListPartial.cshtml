@model IEnumerable<Pta_231220711_on_tap_de_thi_mau.Models.HangHoa>

<div class="section group">
    @if (Model != null && Model.Any())
    {
        int count = 0;
        foreach (var item in Model)
        {
            <div class="grid_1_of_4 images_1_of_4" style="margin-bottom: 25px;">
                <a href="javascript:void(0);">
                    <img src="~/images/@item.Anh" alt="@item.TenHang" style="height: 160px; width: 100%; object-fit: contain;" />
                </a>
                <h2 style="height: 38px; overflow: hidden; margin-top: 10px;">@item.TenHang.ToUpper()</h2>
                <div class="price-details">
                    <div class="price-number">
                        <p><span class="rupees">@string.Format("{0:N0}", item.Gia)</span></p>
                    </div>
                    <div class="add-cart">
                        <h4><a href="javascript:void(0);">Add to Cart</a></h4>
                    </div>
                    <div class="clear"></div>
                </div>
            </div>
            count++;
            if (count % 4 == 0)
            {
                <div class="clear"></div>
            }
        }
        <div class="clear"></div>
    }
    else
    {
        <div style="padding: 30px; text-align: center; color: #666; font-size: 16px;">
            Không có hàng hóa nào phù hợp.
        </div>
    }
</div>

